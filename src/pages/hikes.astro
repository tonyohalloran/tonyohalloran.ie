---
import Base from '../layouts/Base.astro';
import { hikes } from '../data/site';
---

<Base title="Hikes" description="The best hikes, with photographic evidence." wide>
  <p class="kicker">/hikes</p>
  <h1 class="page-title">On foot, for a change</h1>
  <p class="intro">
    Sometimes the bike stays at home. These are the walks that earned a page.
  </p>

  <div class="hike-list">
    {hikes.map((h) => (
      <section class="hike">
        <div class="hike-head">
          <h2>{h.name}</h2>
          <span class="hike-region mono">{h.region}</span>
        </div>
        {h.line && <p class="hike-line">{h.line}</p>}
        <div class="hike-gallery">
          {h.images.length > 0
            ? h.images.map((img) => (
                <img src={`/images/hikes/${img}`} alt={h.name} loading="lazy" />
              ))
            : <div class="photo-slot mono">photos to come</div>}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .intro { color: var(--ink-soft); max-width: 38rem; }

  .hike { margin-top: 2.5rem; }
  .hike-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .hike h2 { font-size: 1.3rem; margin: 0; }
  .hike-region { font-size: 0.72rem; color: var(--ink-faint); }
  .hike-line { color: var(--ink-soft); margin: 0.4rem 0 0; max-width: 38rem; }

  .hike-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .hike-gallery img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 10px; border: 1px solid var(--line);
  }
  .photo-slot {
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--line);
    border-radius: 10px;
    display: grid; place-items: center;
    color: var(--ink-faint);
    font-size: 0.75rem;
  }
</style>
